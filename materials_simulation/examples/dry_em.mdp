; Derived from ZIL em.mdp; only unused water FLEXIBLE macro removed for dry regression.
integrator               = steep
nsteps                   = 50000
emtol                    = 500.0
emstep                   = 0.01
cutoff-scheme            = Verlet
nstlist                  = 20
verlet-buffer-tolerance  = 0.005
rlist                    = 1.2
vdwtype                  = Cut-off
vdw-modifier             = Potential-shift
rvdw                     = 1.2
DispCorr                 = EnerPres
coulombtype              = PME
rcoulomb                 = 1.2
fourierspacing           = 0.12
pme-order                = 4
ewald-rtol               = 1e-5
pbc                      = xyz
constraints              = none
