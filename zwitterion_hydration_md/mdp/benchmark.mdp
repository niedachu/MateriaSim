integrator               = md
dt                       = 0.002
nsteps                   = 500000
continuation             = yes
constraint-algorithm     = lincs
constraints              = h-bonds
lincs-iter               = 1
lincs-order              = 4
cutoff-scheme            = Verlet
nstlist                  = 20
verlet-buffer-tolerance  = 0.005
vdwtype                  = Cut-off
vdw-modifier             = Potential-shift
rvdw                     = 1.2
DispCorr                 = EnerPres
coulombtype              = PME
rcoulomb                 = 1.2
fourierspacing           = 0.12
pme-order                = 4
ewald-rtol               = 1e-5
tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 1.0
ref-t                    = 298.0
pcoupl                   = Parrinello-Rahman
pcoupltype               = isotropic
tau-p                    = 5.0
ref-p                    = 1.0
compressibility          = 4.5e-5
gen-vel                  = no
nstxout                   = 0
nstvout                   = 0
nstfout                   = 0
nstxout-compressed       = 5000
nstenergy                = 5000
nstlog                   = 5000
pbc                      = xyz
comm-mode                = Linear
nstcomm                  = 100
comm-grps                = System

