# The two frozen molecular templates are actual inputs to committed examples.
# Do not unignore the rest of parameterization outputs or trajectories.
!/ion_pair_hydration_md/parameterization/results/
/ion_pair_hydration_md/parameterization/results/*
!/ion_pair_hydration_md/parameterization/results/cat/
!/ion_pair_hydration_md/parameterization/results/ani/
/ion_pair_hydration_md/parameterization/results/cat/*
/ion_pair_hydration_md/parameterization/results/ani/*
!/ion_pair_hydration_md/parameterization/results/cat/cat.gro
!/ion_pair_hydration_md/parameterization/results/ani/ani.gro

# Raw experimental data and document exports are retained locally.
*.xlsx
*.xls
*.pdf
*.pptx
*.docx

